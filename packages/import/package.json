{
  "name": "@dc/import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns outside material (an HTML page first) into tingly-design project files that edit both ways.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./extract": "./src/extract.ts"
  },
  "bin": {
    "dc-import": "bin/dc-import.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@dc/core": "workspace:*",
    "@types/pngjs": "6.0.5",
    "esbuild": "^0.28.2",
    "pixelmatch": "7.1.0",
    "playwright-core": "1.56.0",
    "pngjs": "7.0.0",
    "vitest": "^5.0.3"
  }
}
