{
  "name": "@dc/export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Export from the browser with nothing to install: pictures of a DOM tree, video (MP4 or WebM) and GIF from frames, and a list of what each browser can write.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./timing": "./src/timing.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "mediabunny": "^1.61.4"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
