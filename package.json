{
  "name": "tingly-design",
  "private": true,
  "version": "0.1.0",
  "description": "A design editor with two-way editing: canvases, slides, design systems, dashboards, docs and motion pieces as plain files.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingly-dev/tingly-design.git"
  },
  "homepage": "https://github.com/tingly-dev/tingly-design",
  "bugs": "https://github.com/tingly-dev/tingly-design/issues",
  "keywords": [
    "design",
    "editor",
    "canvas",
    "slides",
    "design-system",
    "dashboard",
    "motion",
    "claude-code",
    "cli"
  ],
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @dc/sandbox build && concurrently -k -n sandbox,server,editor -c magenta,blue,green \"pnpm --filter @dc/sandbox dev\" \"pnpm --filter @dc/server dev\" \"pnpm --filter @dc/editor dev\"",
    "build": "pnpm --filter @dc/sandbox build && pnpm --filter @dc/editor build",
    "start": "pnpm build && pnpm --filter @dc/server start",
    "test": "pnpm --filter @dc/core --filter @dc/import --filter @dc/i18n --filter @dc/export test && node --test evals/test/evals.test.mjs && node scripts/check-coverage.mjs",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip --no-progress",
    "depcheck": "depcruise apps packages --config .dependency-cruiser.cjs",
    "bundle": "node scripts/bundle.mjs",
    "dc-import": "node packages/import/bin/dc-import.mjs",
    "tingly-design": "tsx apps/server/src/cli.ts",
    "e2e": "python3 e2e/run.py",
    "eval": "node evals/run.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^16.10.4",
    "esbuild": "^0.28.2",
    "knip": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
